# Build output
node_modules/
.next/
.next-*/
out/
test-results/
*.tsbuildinfo

# tools/pycheck scratch (fenced-code-block temp files, deleted at the end of every run;
# gitignored as a safety net if a run is interrupted)
.pycheck-scratch/
__pycache__/

# Secrets and machine-local config
.env*
.vercel/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# OS
.DS_Store

# Run logs and reports written by manual tools (link verification) — regenerated
# on each run, not scratch by definition but not meant to be committed either
reports/
