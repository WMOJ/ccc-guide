# Build and test output
node_modules/
.next/
.next-*/
out/
test-results/
playwright-report/
*.tsbuildinfo

# tools/pycheck scratch (fenced-code-block temp files, deleted at the end of every run;
# gitignored as a safety net if a run is interrupted)
.pycheck-scratch/
__pycache__/

# scripts/check-production-mode.mjs's isolated production build (G-E2E production-mode proof);
# deleted at the end of every run, gitignored as a safety net if a run is interrupted
.next-prod-check/

# Secrets and machine-local config
.env*
.vercel/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# OS
.DS_Store
