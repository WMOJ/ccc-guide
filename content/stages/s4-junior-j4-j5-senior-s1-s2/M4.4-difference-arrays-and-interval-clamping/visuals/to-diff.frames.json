{"caption":"diff[1] = arr[1] - arr[0] = 7 - 7 = 0.","panels":{"arr":{"values":[7,7,7,7],"pointers":[{"name":"i","at":1,"side":"above","strong":true}]},"diff":{"values":[7,0,null,null],"states":"dc__"}}},
{"caption":"diff[2] = arr[2] - arr[1] = 7 - 7 = 0.","panels":{"arr":{"values":[7,7,7,7],"pointers":[{"name":"i","at":2,"side":"above","strong":true}]},"diff":{"values":[7,0,0,null],"states":"ddc_"}}},
{"caption":"diff[3] = arr[3] - arr[2] = 7 - 7 = 0.","panels":{"arr":{"values":[7,7,7,7],"pointers":[{"name":"i","at":3,"side":"above","strong":true}]},"diff":{"values":[7,0,0,0],"states":"dddc"}}},
{"caption":"That is the difference array. Now prefix-sum it, left to right, to rebuild the original.","panels":{"arr":{"values":[null,null,null,null]},"diff":{"values":[7,0,0,0]}}},
{"caption":"rebuilt[0] is just diff[0]: 7.","panels":{"arr":{"values":[7,null,null,null],"states":"c___"},"diff":{"values":[7,0,0,0],"pointers":[{"name":"i","at":0,"side":"above","strong":true}]}}},
{"caption":"rebuilt[1] = rebuilt[0] + diff[1] = 7 + 0 = 7.","panels":{"arr":{"values":[7,7,null,null],"states":"dc__"},"diff":{"values":[7,0,0,0],"pointers":[{"name":"i","at":1,"side":"above","strong":true}]}}},
{"caption":"rebuilt[2] = rebuilt[1] + diff[2] = 7 + 0 = 7.","panels":{"arr":{"values":[7,7,7,null],"states":"ddc_"},"diff":{"values":[7,0,0,0],"pointers":[{"name":"i","at":2,"side":"above","strong":true}]}}},
{"caption":"rebuilt[3] = rebuilt[2] + diff[3] = 7 + 0 = 7.","panels":{"arr":{"values":[7,7,7,7],"states":"dddc"},"diff":{"values":[7,0,0,0],"pointers":[{"name":"i","at":3,"side":"above","strong":true}]}}},
{"caption":"The rebuilt array, [7, 7, 7, 7], matches the original exactly. diff and arr hold the same information in two different forms; a prefix sum turns one into the other.","panels":{"arr":{"values":[7,7,7,7]},"diff":{"values":[7,0,0,0]}}}
]},
