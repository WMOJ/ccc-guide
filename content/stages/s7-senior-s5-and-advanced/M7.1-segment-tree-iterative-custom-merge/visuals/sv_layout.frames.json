{"caption":"The parent of node 5 is 5 // 2 = 2. Node 2 holds 4, the sum of everything beneath it.","panels":{"t":{"root":{"id":"1","label":"9","note":"#1","children":[{"id":"2","label":"4","note":"#2","s":"c","children":[{"id":"4","label":"3","note":"#4"},{"id":"5","label":"1","note":"#5","s":"d"}]},{"id":"3","label":"5","note":"#3","children":[{"id":"6","label":"4","note":"#6"},{"id":"7","label":"1","note":"#7"}]}]}},"a":{"values":["-",9,4,5,3,1,4,1],"states":"__c__d__"}}},
{"caption":"The parent of node 2 is 2 // 2 = 1. Node 1 holds 9, the sum of everything beneath it.","panels":{"t":{"root":{"id":"1","label":"9","note":"#1","s":"c","children":[{"id":"2","label":"4","note":"#2","s":"d","children":[{"id":"4","label":"3","note":"#4"},{"id":"5","label":"1","note":"#5","s":"d"}]},{"id":"3","label":"5","note":"#3","children":[{"id":"6","label":"4","note":"#6"},{"id":"7","label":"1","note":"#7"}]}]}},"a":{"values":["-",9,4,5,3,1,4,1],"states":"_cd__d__"}}},
